{
  "name": "lannihilator",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/dev.mjs --production",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "tsc --noEmit && prettier --check src tests scripts index.html package.json tsconfig.json && node scripts/check.mjs",
    "format": "prettier --write src tests scripts index.html package.json tsconfig.json",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.8.3"
  }
}
